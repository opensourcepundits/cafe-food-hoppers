# Local Docker Postgres (compose.yaml maps host 5433 → container 5432)
DATABASE_URL="postgres://root:mysecretpassword@127.0.0.1:5433/local"

# Supabase (Vercel)
# Project → Settings → Database → Connection string → URI
# Use Transaction pooler (port 6543) for the app:
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
#
# Direct (db.PROJECT.supabase.co:5432) is optional for tools:
# DATABASE_URL_UNPOOLED="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Supabase JS client (safe to expose — this is the publishable/anon key)
PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service role key is used server-side to upload venue photos to a public bucket.
# Settings → API → service_role. Never expose this in the browser.
# SUPABASE_SERVICE_ROLE_KEY="..."

# Admin accounts live in the users table. Register at /admin/register.
# Superusers are seeded (not created by registration) and are the only role that can open /admin/users.
# SUPERUSER_EMAIL="you@example.com"
# SUPERUSER_PASSWORD="at-least-8-characters"
# Extra accounts, JSON array of { "email", "password" }:
# SUPERUSER_ACCOUNTS='[{"email":"other@example.com","password":"at-least-8-characters"}]'

# Web Push. Set these in Vercel → Settings → Environment Variables (same place as DATABASE_URL).
# The app reads VAPID_* and, if Vercel prefixes them, CAFE_DB_VAPID_*.
# Generate the key pair once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
# Supabase pg_cron sends this as Authorization: Bearer … to /api/push/dispatch.
# Store the same value in Supabase Vault as place_cron_secret (see supabase/push_cron.sql).
# CRON_SECRET=""

# WhatsApp Cloud API (optional). Same alerts as Web Push, for users who opt in on /profile.
# Create a Meta app with WhatsApp, a phone number ID, and a permanent system-user token.
# Approve two templates before live sends work:
#   place_event  (utility)  — "starts soon" and "is starting"
#   place_promo  (marketing) — "is on now"
# Body variables: {{1}} title line, {{2}} short detail.
# URL button: https://place.dot42.dev/{{1}}  with {{1}} set to venues/{slug}
# Webhook: https://place.dot42.dev/api/whatsapp  (verify token + app secret)
# The app also reads CAFE_DB_WHATSAPP_* if Vercel prefixes them.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_EVENT_TEMPLATE="place_event"
# WHATSAPP_PROMO_TEMPLATE="place_promo"
# WHATSAPP_TEMPLATE_LANG="en"
# PUBLIC_SITE_ORIGIN="https://place.dot42.dev"
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
