# Local Docker Postgres (compose.yaml maps host 5433 → container 5432)
DATABASE_URL="postgres://root:mysecretpassword@127.0.0.1:5433/local"

# Neon (Vercel)
# Use the pooled connection string for the app at runtime.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Use the direct (unpooled) connection for drizzle-kit migrate.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
